// fastfetch layout for yunagi-about (Omarchy-style boxes)
{
  "logo": { "type": "none" },
  "display": { "separator": ": " },
  "modules": [
    { "type": "custom", "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐" },
    { "type": "host", "key": " PC", "keyColor": "blue" },
    { "type": "cpu", "key": "│ ├ ", "showPeCoreCount": true, "keyColor": "blue" },
    { "type": "gpu", "key": "│ ├󰢮 ", "keyColor": "blue" },
    { "type": "display", "key": "│ ├󰍹 ", "keyColor": "blue" },
    { "type": "disk", "key": "│ ├󰋊 ", "folders": "/", "keyColor": "blue" },
    { "type": "memory", "key": "│ ├󰍛 ", "keyColor": "blue" },
    { "type": "swap", "key": "└ └󱃺 ", "keyColor": "blue" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "format": "\u001b[90m┌──────────────────────Software──────────────────────┐" },
    { "type": "os", "key": " OS", "format": "{name}", "keyColor": "blue" },
    { "type": "command", "key": "│ ├󰣇 ", "text": "printf 'Yunagi %s' \"$(cat ~/.local/share/yunagi/VERSION 2>/dev/null || echo dev)\"", "keyColor": "blue" },
    { "type": "command", "key": "│ ├󰈬 ", "text": "echo rolling", "keyColor": "blue" },
    { "type": "kernel", "key": "│ ├ ", "keyColor": "blue" },
    { "type": "wm", "key": "│ ├ ", "keyColor": "blue" },
    { "type": "terminal", "key": "│ ├ ", "keyColor": "blue" },
    { "type": "packages", "key": "│ ├󰋆 ", "keyColor": "blue" },
    { "type": "command", "key": "│ ├󰏨 ", "text": "printf 'Matugen \\033[31m●\\033[32m●\\033[33m●\\033[34m●\\033[35m●\\033[36m●\\033[37m●\\033[0m'", "keyColor": "blue" },
    { "type": "terminalfont", "key": "└ └ ", "keyColor": "blue" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐" },
    { "type": "command", "key": "󱆟 OS Age", "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days", "keyColor": "magenta" },
    { "type": "uptime", "key": "󱛌 Uptime", "keyColor": "magenta" },
    { "type": "command", "key": " Update", "text": "t=$(grep 'starting full system upgrade' /var/log/pacman.log | tail -1 | cut -c2-25); [ -n \"$t\" ] && LC_TIME=C date -d \"$t\" '+%A %d %B %Y at %H:%M' || echo never", "keyColor": "magenta" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────┘" }
  ]
}
