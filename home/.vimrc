" Same look as nvim (~/.config/nvim/init.lua)
syntax on
set number
set termguicolors
set cursorline

set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab

colorscheme unokai

highlight Normal guibg=NONE ctermbg=NONE
highlight SignColumn guibg=NONE ctermbg=NONE
highlight EndOfBuffer guibg=NONE ctermbg=NONE
