#!/bin/sh
set -e

case "${1:-output}" in
    region|shared)
        hyprpicker -r -z & pick=$!
        sleep 0.2
        geom=$(slurp -d) || { kill $pick; exit 1; }
        if [ "$1" = shared ]; then
            # Only saved where the AI account can read it, not to the clipboard
            file=/home/delat/screenshots/Screenshot_$(date +%Y%m%d_%H%M%S).png
            grim -g "$geom" "$file" || { kill $pick; exit 1; }
            notify-send -i "$file" "Screenshot saved" "$file" &
        else
            grim -g "$geom" - | wl-copy --type image/png
        fi
        kill $pick
        ;;
    *)
        out=$(hyprctl monitors -j | python3 -c 'import json,sys; ms=json.load(sys.stdin); print(next(m["name"] for m in ms if m.get("focused")))')
        grim -o "$out" - | wl-copy --type image/png
        ;;
esac

pw-play /usr/share/sounds/freedesktop/stereo/camera-shutter.oga >/dev/null 2>&1 &
