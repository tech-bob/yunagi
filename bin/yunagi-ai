#!/usr/bin/env bash
# yunagi-ai — the AI page in Yunagi's menu.
#
#   yunagi-ai status            JSON for the menu: the AI account and the state of each item
#   yunagi-ai do ITEM [NAME]    sets ITEM up in this terminal, with sudo where needed
#   yunagi-ai menu              the AI page in a terminal, for desktops without Yunagi's menu
#
# Items: account (creates the AI account, the group delat and the account's Yunagi
# config), own (the agents in your own account instead, no AI account), claude, codex, grok (agents in the AI account), usage (the usage timers for
# the bar), grokbot, hermes (the admin's desktop apps, AUR), password (the AI account's,
# for su), tmux (shared terminal). The agents, usage and tmux need the account first. The AI account has no sudo; the agents and their
# logins live in its home. Logged in as the AI account, only its own agents are set up.
set -euo pipefail

conf=/etc/yunagi/ai-user
shared=/home/delat
usage_file=$shared/ai-usage.json

declare -A url=([claude]=https://claude.ai/install.sh [codex]=https://chatgpt.com/codex/install.sh [grok]=https://x.ai/cli/install.sh)
declare -A login=([claude]="claude auth login" [codex]="codex login" [grok]="grok login --oauth")
declare -A bin=([claude]=.local/bin/claude [codex]=.local/bin/codex [grok]=.grok/bin/grok)
declare -A cred=([claude]=.claude/.credentials.json [codex]=.codex/auth.json [grok]=.grok/auth.json)
declare -A pkg=([grokbot]=grok-bot-bin [hermes]=hermes-agent-desktop)

# The configured AI account, else a member of delat without sudo, else none
account() {
    local a
    a=$(cat "$conf" 2>/dev/null || true)
    if [ -n "$a" ] && id "$a" &>/dev/null; then echo "$a"; return; fi
    for a in $(getent group delat | cut -d: -f4 | tr , ' '); do
        if [ "$a" != "$USER" ] && ! id -nG "$a" | grep -qwE 'wheel|sudo'; then echo "$a"; return; fi
    done
}

# Logged in as the AI account itself: named in the config, else no sudo and in delat
is_ai() {
    local a
    a=$(cat "$conf" 2>/dev/null || true)
    if [ -n "$a" ]; then [ "$a" = "$USER" ]; return; fi
    id -nG | grep -qw delat && ! id -nG | grep -qwE 'wheel|sudo'
}

# --- Status ------------------------------------------------------------------

status() {
    local ai self=false own=false k s items=()
    if is_ai; then ai=$USER self=true; else ai=$(account); fi
    # Your own account chosen for the agents: an admin, so the apps are shown too
    $self && id -nG | grep -qwE 'wheel|sudo' && own=true
    for k in claude codex grok; do
        if $self; then
            [ -s "$HOME/${cred[$k]}" ] && s=ready || s=setup
        else
            # Signed in when the usage timer can read it; the AI account's home is closed
            s=setup
            [ -n "$ai" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(not (d.get("account")==sys.argv[2] and any(a["id"]==sys.argv[3] for a in d.get("agents",[]))))' \
                "$usage_file" "$ai" "$k" 2>/dev/null && s=ready
        fi
        items+=("\"$k\":\"$s\"")
    done
    if $self; then
        systemctl --user is-enabled -q yunagi-ai-usage.timer 2>/dev/null && s=ready || s=install
    else
        systemctl is-enabled -q yunagi-ai-usage.timer 2>/dev/null && s=ready || s=install
    fi
    items+=("\"usage\":\"$s\"")
    if $own; then
        for k in grokbot hermes; do
            pacman -T "${pkg[$k]}" >/dev/null && s=ready || s=install
            items+=("\"$k\":\"$s\"")
        done
    fi
    if ! $self; then
        # The AI account's home and /etc/shadow are closed: marks in /etc/yunagi tell
        [ -n "$ai" ] && [ "$(cat /etc/yunagi/ai-config 2>/dev/null)" = "$ai" ] && s=ready || s=install
        items+=("\"config\":\"$s\"")
        [ -n "$ai" ] && [ "$(cat /etc/yunagi/ai-password 2>/dev/null)" = "$ai" ] && s=ready || s=setup
        items+=("\"password\":\"$s\"")
        for k in grokbot hermes; do
            pacman -T "${pkg[$k]}" >/dev/null && s=ready || s=install
            items+=("\"$k\":\"$s\"")
        done
        [ -f "$HOME/.config/fish/functions/tmuxdela.fish" ] && [ -d "$shared/terminal" ] && s=ready || s=install
        items+=("\"tmux\":\"$s\"")
    fi
    printf '{"account":"%s","self":%s,"own":%s,%s}\n' "$ai" "$self" "$own" "$(IFS=,; echo "${items[*]}")"
}

# --- Setting up, in a terminal ------------------------------------------------

say() { printf '\n\e[1;36m%s\e[0m\n' "$*"; }

# The AI account must exist before anything is set up in it
need_account() {
    ai=$(account)
    [ -n "$ai" ] || { echo "Create the AI account first (Account in the AI page)."; return 1; }
}

# Yunagi's config (Hyprland, fish, kitty…) in the AI account, from your own copy
account_config() {
    local repo=$HOME/.local/share/yunagi
    [ -x "$repo/install.sh" ] || { echo "No Yunagi copy in $repo; the config was not copied."; return 0; }
    say "Yunagi config for $ai"
    # Your keyboard layout: from the settings menu, else the system's
    local kb
    kb=$(sed -n 's/^ *kb_layout = "\(.*\)",$/\1/p' "$HOME/.config/hypr/settings.lua" 2>/dev/null)
    [ -n "$kb" ] || kb=$(localectl status | sed -n 's/^ *X11 Layout: //p')
    sudo "$repo/install.sh" --config-only --user "$ai" ${kb:+--keyboard "$kb"}
    echo "$ai" | sudo install -Dm644 /dev/stdin /etc/yunagi/ai-config
}

set_password() {
    say "Password for $ai (for logging in and su $ai)"
    sudo passwd "$ai"
    echo "$ai" | sudo install -Dm644 /dev/stdin /etc/yunagi/ai-password
}

# The AI account, the group delat and /home/delat; a name only matters the first time
ensure_account() {
    ai=$(account)
    if [ -z "$ai" ]; then
        ai=${1:-ai}
        [[ $ai =~ ^[a-z_][a-z0-9_-]{0,31}$ && $ai != root && $ai != "$USER" ]] || { echo "Invalid account name: $ai"; return 1; }
        say "Creating the AI account $ai (no sudo)"
        sudo groupadd -f delat
        sudo useradd -m -G delat -s /usr/bin/fish "$ai"
        created=yes
    fi
    if id -nG "$ai" | grep -qwE 'wheel|sudo'; then echo "$ai has sudo; the AI account must not."; return 1; fi
    id -nG "$ai" | grep -qw delat || sudo usermod -aG delat "$ai"
    if ! id -nG "$USER" | grep -qw delat; then
        sudo usermod -aG delat "$USER"
        echo "You were added to delat; it takes effect when you restart the computer."
    fi
    [ -d "$shared" ] || sudo install -d -m 2775 -o root -g delat "$shared"
    [ "$(cat "$conf" 2>/dev/null)" = "$ai" ] || echo "$ai" | sudo install -Dm644 /dev/stdin "$conf"
    # The agents live in ~/.local/bin and ~/.grok/bin
    case $(getent passwd "$ai" | cut -d: -f7) in
        */fish) sudo -u "$ai" -H sh -c 'f=~/.config/fish/conf.d/yunagi-ai.fish; [ -e $f ] || { mkdir -p ${f%/*}; echo "fish_add_path -g ~/.local/bin ~/.grok/bin" >$f; }' ;;
        *) sudo -u "$ai" -H sh -c 'grep -qs yunagi-ai ~/.bashrc || echo "export PATH=\"\$HOME/.local/bin:\$HOME/.grok/bin:\$PATH\"  # yunagi-ai" >>~/.bashrc' ;;
    esac
    [ "${created:-}" = yes ] && account_config
    return 0
}

# Runs a command as the AI account, or as yourself when you are it
as_ai() {
    if is_ai; then
        env PATH="$HOME/.local/bin:$HOME/.grok/bin:$PATH" "$@"
    else
        local h; h=$(getent passwd "$ai" | cut -d: -f6)
        sudo -u "$ai" -H env -C "$h" PATH="$h/.local/bin:$h/.grok/bin:/usr/local/bin:/usr/bin" "$@"
    fi
}

usage_units() {
    printf '[Unit]\nDescription=AI usage for the Yunagi bar\nAfter=network-online.target\n\n[Service]\nType=oneshot\n%sExecStart=/usr/local/bin/yunagi-ai-usage\n' "${1:+$1$'\n'}"
}
usage_timer() {
    printf '[Unit]\nDescription=AI usage for the Yunagi bar, every 5 minutes\n\n[Timer]\nOnBootSec=1min\nOnUnitActiveSec=5min\n\n[Install]\nWantedBy=timers.target\n'
}

# The usage timer in your own account: your agents, or as the admin your Grok Bot
ensure_own_usage() {
    local u=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
    if ! systemctl --user is-enabled -q yunagi-ai-usage.timer 2>/dev/null; then
        mkdir -p "$u"
        usage_units "" >"$u/yunagi-ai-usage.service"
        usage_timer >"$u/yunagi-ai-usage.timer"
        systemctl --user daemon-reload
        systemctl --user enable --now yunagi-ai-usage.timer
    fi
    systemctl --user start yunagi-ai-usage.service || true
}

# The usage timer in the AI account as a system unit run as $ai, plus your own
ensure_usage() {
    if ! is_ai && ! systemctl is-enabled -q yunagi-ai-usage.timer 2>/dev/null; then
        say "Usage timer for $ai"
        usage_units "User=$ai" | sudo tee /etc/systemd/system/yunagi-ai-usage.service >/dev/null
        usage_timer | sudo tee /etc/systemd/system/yunagi-ai-usage.timer >/dev/null
        sudo systemctl daemon-reload
        sudo systemctl enable --now yunagi-ai-usage.timer
    fi
    # Fresh numbers now, so the menu shows the result
    is_ai || sudo systemctl start yunagi-ai-usage.service || true
    ensure_own_usage
}

agent() {
    local k=$1
    if ! as_ai sh -c "test -x \"\$HOME/${bin[$k]}\""; then
        say "Installing $k"
        as_ai bash -c "curl -fsSL ${url[$k]} | bash"
    fi
    say "Signing in to $k: open the link (Ctrl+click), sign in, then come back here"
    as_ai ${login[$k]}
    ensure_usage
}

restart_shell() {
    say "Restarting the bar, so the new app's icon shows"
    pkill -x qs || true; pkill -x quickshell || true
    sleep 1
    hyprctl dispatch "hl.dsp.exec_cmd('qs -n -d')" >/dev/null
}

aur() {
    local p=${pkg[$1]}
    if ! command -v paru >/dev/null; then
        say "Installing paru"
        local d; d=$(mktemp -d)
        sudo pacman -S --needed base-devel git
        git clone https://aur.archlinux.org/paru-bin.git "$d"
        (cd "$d" && makepkg -si)
        rm -rf "$d"
    fi
    say "Installing $p"
    paru -Syu --needed "$p"
    restart_shell
}

shared_terminal() {
    say "Shared terminal"
    sudo pacman -S --needed tmux
    sudo install -d -m 2775 -o root -g delat "$shared/terminal"
    local f=$HOME/.config/fish/functions
    mkdir -p "$f"
    cat >"$f/tmuxdela.fish" <<'EOF'
function tmuxdela --description 'tmux shared with the AI account, read-only (tmuxdela w: writable)'
    set -l sock /home/delat/terminal/delad
    set -l ai (cat /etc/yunagi/ai-user)
    # Added to delat during this login: the session gets the group at the next login
    if not contains delat (id -Gn | string split " ")
        echo "Restart the computer first: delat is new since you logged in."
        return 1
    end
    set -l mode r
    test "$argv[1]" = w; and set mode w
    if set -q TMUX
        tmux -S $sock server-access -a $ai 2>/dev/null
        tmux -S $sock server-access -$mode $ai
        return
    end
    tmux -S $sock new -A -s delad \; run-shell "chmod g+rw $sock; tmux -S $sock server-access -a $ai 2>/dev/null; tmux -S $sock server-access -$mode $ai"
end
EOF
    printf "function tmuxdelaw --description 'tmux shared with the AI account, writable'\n    tmuxdela w\nend\n" >"$f/tmuxdelaw.fish"
    echo "tmuxdela lets $ai watch, tmuxdelaw lets it type; it joins with: tmux -S $shared/terminal/delad attach"
}

do_item() {
    local item=$1 name=${2:-}
    ai=$USER
    case $item in
        account) ensure_account "$name"; set_password ;;
        own)
            say "The agents in your own account ($USER)"
            echo "$USER" | sudo install -Dm644 /dev/stdin "$conf" ;;
        config) need_account; account_config ;;
        claude|codex|grok) is_ai || need_account; agent "$item" ;;
        usage) is_ai || need_account; ensure_usage ;;
        grokbot|hermes) aur "$item"; ensure_own_usage ;;
        password) need_account; set_password ;;
        tmux) need_account; shared_terminal ;;
        *) echo "Unknown item: $item"; return 1 ;;
    esac
}

# The AI page as a terminal menu (gum): the same rows as in Yunagi's menu
menu() {
    local rows choice key name
    while true; do
        rows=$(status | python3 -I -c '
import json, sys
s = json.load(sys.stdin)
st = {"install": "Install", "setup": "Set up", "ready": "Ready"}
def row(k, label): print(f"{k}\t{label:<22}{st.get(s.get(k), str())}")
if not s["self"] and not s["account"]:
    print("account\tCreate AI account      Safer: a user without sudo")
    print("own\tUse my own account     Risky: agents can read your files")
else:
    if not s["self"]:
        row("password", "Password")
        if s.get("config") != "ready": row("config", "Yunagi config")
    for k, l in (("claude", "Claude Code"), ("codex", "Codex"), ("grok", "Grok CLI"), ("usage", "Usage")): row(k, l)
    if not s["self"] and s.get("tmux") != "ready": row("tmux", "Shared terminal")
if not s["self"] or s.get("own"):
    row("grokbot", "Grok Bot"); row("hermes", "Hermes")
')
        choice=$(cut -f2 <<<"$rows" | gum choose --header "AI · $(status | python3 -I -c 'import json,sys; s=json.load(sys.stdin); print(s["account"] or "no account yet")')" ) || return 0
        key=$(grep -F "$(printf '\t%s' "$choice")" <<<"$rows" | head -1 | cut -f1)
        name=
        if [ "$key" = account ]; then
            name=$(gum input --header "Name of the AI account" --value ai) || continue
        fi
        if ( set -e; do_item "$key" $name ); then printf '\n\e[32mDone\e[0m — press Enter'
        else printf '\n\e[31mFailed\e[0m — press Enter'; fi
        read -r _
    done
}

case ${1:-} in
    status) status ;;
    menu) menu ;;
    do)
        trap 'printf "\n\e[31mFailed\e[0m — press Enter to close"; read -r _' ERR
        do_item "${@:2}"
        printf '\n\e[32mDone\e[0m — press Enter to close'; read -r _ ;;
    *) echo "usage: yunagi-ai status | do ITEM [NAME] | menu" >&2; exit 1 ;;
esac
