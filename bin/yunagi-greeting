#!/usr/bin/env bash
# Greeting for the lock screen, by time of day. Same line for the whole hour.
# The same lines are in sddm/yunagi/Main.qml (greeting()); change both.
# Name: Settings → Lock screen → Your name, else the account's full name, else the login.
state=${XDG_STATE_HOME:-$HOME/.local/state}/yunagi/display-name
name=$(cat "$state" 2>/dev/null)
[ -n "$name" ] || name=$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)
name=${name:-$USER}
name=${name//&/&amp;}; name=${name//</&lt;}; name=${name//>/&gt;}
name="<span foreground=\"#7dd3fc\">$name</span>"
hour=$(date +%-H)
day=$(date +%u)

if ((hour >= 5 && hour < 11)); then
    lines=("Good morning, $name" "Morning, $name" "Coffee first, $name?" "Slow start, $name?"
           "Fresh day, $name" "Up early, $name?" "Easy does it, $name")
elif ((hour >= 11 && hour < 17)); then
    lines=("Good afternoon, $name" "Hey there, $name" "Back at it, $name" "Afternoon, $name"
           "Welcome back, $name" "Short break, $name?" "Where were we, $name?")
elif ((hour >= 17 && hour < 22)); then
    lines=("Good evening, $name" "Evening, $name" "How was your day, $name?" "Winding down, $name?"
           "One more thing, $name?" "Feet up, $name?" "Calm evening, $name")
else
    lines=("Night owl mode, $name" "Still up, $name?" "Late one, $name?" "Quiet hours, $name"
           "Just one more, $name?" "Moon's out, $name" "The night is young, $name")
fi
((day == 1 && hour < 12)) && lines+=("New week, $name")
((day == 5 && hour >= 15 && hour < 17)) && lines+=("Almost Friday night, $name")
((day == 5 && hour >= 17 && hour < 22)) && lines=("Happy Friday, $name" "Beer o'clock, $name?"
                                              "Weekend mode, $name" "Made it to Friday, $name")
((day >= 6)) && lines+=("Easy weekend, $name?" "No rush today, $name")

seed=$(( $(date +%j | sed 's/^0*//') * 24 + hour ))
echo "<span weight=\"300\">${lines[seed % ${#lines[@]}]}</span>"
